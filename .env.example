# All defaults work locally. No hosted services or API keys are required.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/waypoint.sqlite
SESSION_DAYS=7
# Enable only when the app is served over HTTPS.
COOKIE_SECURE=false
# Optional: used only by npm run db:seed. Set a unique password of 12+ characters.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=
